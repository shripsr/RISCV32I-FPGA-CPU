module alu_adder(
	input logic [31:0] a,
	input logic [31:0] b,
	input logic add_sub, //0 for add, 1 for sub
	output logic [31:0] sum,
	output logic cout,
	output logic ovfl
);

	logic [31:0] sign_b;
	
	assign sign_b = sub ? ~b : b;
	
	assign {cout, sum} = a = sign_b + add_sub;
	
	assign ovfl = (a[31] == sign_b[31]) && (sum[31] != a[31]);
	
endmodule
